# 상위 LLM — Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# 모델: 기본 claude-opus-5. 비용 절감이 필요하면 claude-haiku-4-5 ($1/$5 per MTok)
LLM_MODEL=claude-opus-5
# 추론 깊이: 음성 대화라 지연 최소화 기본 low. 품질 우선이면 high
LLM_EFFORT=low
# 보조 호출(꼬리질문 재작성·영어 질문 번역) 모델. 작은 모델로 충분하고 지연이 줄어든다. 비우면 LLM_MODEL과 같은 모델
LLM_AUX_MODEL=claude-haiku-4-5

# 신뢰도 게이트 임계값 (계약 ① — 검색 최고 점수가 이 값 미만이면 보류 응답. BGE-M3 실측: 관련 0.63+, 무관 0.43-)
GATE_SCORE_THRESHOLD=0.5

# 답변 문장 수 상한 (프롬프트 2~3문장 규칙의 안전장치, 넘으면 문장 단위로 끊음). 0이면 사용 안 함
MAX_SENTENCES=3
